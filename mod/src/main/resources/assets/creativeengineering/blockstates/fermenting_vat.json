{
  "multipart": [
    {
      "when": {
        "bottom": "false"
      },
      "apply": {
        "model": "creativeengineering:block/fermenting_vat_body"
      }
    },
    {
      "when": {
        "bottom": "true",
        "top": "false"
      },
      "apply": {
        "model": "creativeengineering:block/fermenting_vat_body_bottom"
      }
    },
    {
      "when": {
        "bottom": "true",
        "top": "true"
      },
      "apply": {
        "model": "creativeengineering:block/fermenting_vat_body_single"
      }
    },
    {
      "when": {
        "valve": "true"
      },
      "apply": {
        "model": "creativeengineering:block/fermenting_vat_valve"
      }
    },
    {
      "when": {
        "bottom": "true",
        "north": "true",
        "west": "true"
      },
      "apply": {
        "model": "creativeengineering:block/fermenting_vat_foot",
        "y": 0
      }
    },
    {
      "when": {
        "bottom": "true",
        "north": "true",
        "east": "true"
      },
      "apply": {
        "model": "creativeengineering:block/fermenting_vat_foot",
        "y": 90
      }
    },
    {
      "when": {
        "bottom": "true",
        "south": "true",
        "east": "true"
      },
      "apply": {
        "model": "creativeengineering:block/fermenting_vat_foot",
        "y": 180
      }
    },
    {
      "when": {
        "bottom": "true",
        "south": "true",
        "west": "true"
      },
      "apply": {
        "model": "creativeengineering:block/fermenting_vat_foot",
        "y": 270
      }
    }
  ]
}
