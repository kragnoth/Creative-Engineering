{
  "multipart": [
    {
      "when": {
        "bottom": "false"
      },
      "apply": {
        "model": "creativeengineering:block/fermenting_vat_body"
      }
    },
    {
      "when": {
        "bottom": "true"
      },
      "apply": {
        "model": "creativeengineering:block/fermenting_vat_body_bottom"
      }
    },
    {
      "when": {
        "top": "true"
      },
      "apply": {
        "model": "creativeengineering:block/fermenting_vat_lid"
      }
    },
    {
      "when": {
        "valve": "true"
      },
      "apply": {
        "model": "creativeengineering:block/fermenting_vat_valve"
      }
    }
  ]
}
