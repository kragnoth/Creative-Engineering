{
  "multipart": [
    {
      "apply": {
        "model": "creativeengineering:block/copper_campfire_stand"
      }
    },
    {
      "when": {
        "fire": "campfire",
        "lit": "true"
      },
      "apply": {
        "model": "minecraft:block/campfire"
      }
    },
    {
      "when": {
        "fire": "campfire",
        "lit": "false"
      },
      "apply": {
        "model": "minecraft:block/campfire_off"
      }
    },
    {
      "when": {
        "fire": "soul",
        "lit": "true"
      },
      "apply": {
        "model": "minecraft:block/soul_campfire"
      }
    },
    {
      "when": {
        "fire": "soul",
        "lit": "false"
      },
      "apply": {
        "model": "minecraft:block/campfire_off"
      }
    }
  ]
}
